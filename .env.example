# PoC Factory — copy to .env and fill in. .env is gitignored; never commit it.
# RECONSTRUCTED 2026-08-27 (original lost in a skill sync).

# Which Notion Engagement this repo builds. Read from the Engagements DB (ENG-n).
POC_ENGAGEMENT_ID=ENG-2

# Notion integration token, shared with the PoC Factory workspace.
# Required by .claude/hooks/gate_guard.py — without it, deploy is blocked.
NOTION_TOKEN=

# GitHub PAT for the github MCP server (repo scope).
GITHUB_TOKEN=

# Engagement AWS context. Deploys go only to the ephemeral PoC-OU account.
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
