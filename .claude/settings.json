{
  "permissions": {
    "allow": [
      "Bash(npm run *)", "Bash(npx cdk synth*)", "Bash(npx cdk diff*)",
      "Bash(checkov *)", "Bash(git *)", "Bash(gh pr *)"
    ],
    "deny": [
      "Bash(npx cdk deploy*)", "Bash(cdk deploy*)", "Bash(aws configure*)",
      "Read(./.env)", "Read(./**/*.pem)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/gate_guard.py" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/bolt_log_reminder.py" }
        ]
      }
    ]
  }
}
